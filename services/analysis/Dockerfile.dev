# =============================================================================
# Dockerfile.dev — Analysis Service (Development)
# =============================================================================
# Goals:
#   - Fast container startup
#   - Hot reload via uvicorn --reload
#   - Source code mounted as volume (edit on host — reflected instantly)
#   - venv isolated outside /app (volume mount can't shadow or delete it)
#   - All dependencies including dev (ruff, pytest, etc.)
# =============================================================================

FROM python:3.12-slim

WORKDIR /app

# ── System dependencies ──────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── Install uv ──────────────────────────────────────────────────────────────
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# ── Environment ─────────────────────────────────────────────────────────────
ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/opt/venv/bin:$PATH"

# ── Dependency layer (cached unless pyproject.toml or uv.lock changes) ──────
COPY pyproject.toml uv.lock /app/

# Install ALL deps (including dev: ruff, pytest, etc.)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

# ── Application source (overridden by volume mount in dev) ──────────────────
COPY . /app/

EXPOSE 8003

# Healthcheck — docker-compose.dev.yml overrides this, but useful standalone
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8003/api/health/ || exit 1

# CMD left to docker-compose override (alembic migrate + uvicorn)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8003", "--reload"]
