# ── Kraivor Analysis Service ──────────────────────────────────────────────
# Copy to .env and fill in values.
#
#   cp .env.example .env
#
# ── FastAPI ───────────────────────────────────────────────────────────────
ANALYSIS_APP_NAME=Kraivor Analysis Service
ANALYSIS_APP_ENV=development
ANALYSIS_DEBUG=true
ANALYSIS_HOST=0.0.0.0
ANALYSIS_PORT=8003
ANALYSIS_WORKERS=2

# ── Database ──────────────────────────────────────────────────────────────
ANALYSIS_DATABASE__URL=postgresql+asyncpg://kraivor:kraivor@localhost:5432/kraivor_analysis
ANALYSIS_DATABASE__POOL_SIZE=10
ANALYSIS_DATABASE__MAX_OVERFLOW=20
ANALYSIS_DATABASE__ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────
ANALYSIS_REDIS__URL=redis://localhost:6379/0
ANALYSIS_REDIS__CACHE_TTL=3600

# ── Celery ────────────────────────────────────────────────────────────────
ANALYSIS_CELERY__BROKER_URL=redis://localhost:6379/1
ANALYSIS_CELERY__RESULT_BACKEND=redis://localhost:6379/1
ANALYSIS_CELERY__TASK_ALWAYS_EAGER=false
ANALYSIS_CELERY__TASK_EAGER_PROPAGATES=false

# ── S3 / MinIO ────────────────────────────────────────────────────────────
ANALYSIS_S3__ENDPOINT_URL=http://localhost:9000
ANALYSIS_S3__ACCESS_KEY_ID=minioadmin
ANALYSIS_S3__SECRET_ACCESS_KEY=minioadmin
ANALYSIS_S3__BUCKET_NAME=analysis-reports
ANALYSIS_S3__REGION=us-east-1

# ── Kafka ─────────────────────────────────────────────────────────────────
ANALYSIS_KAFKA__BOOTSTRAP_SERVERS=localhost:9092
ANALYSIS_KAFKA__EVENTS_TOPIC=analysis.events

# ── JWT / Auth ────────────────────────────────────────────────────────────
ANALYSIS_IDENTITY__JWKS_URL=http://localhost:8000/.well-known/jwks.json
ANALYSIS_IDENTITY__JWT_ALGORITHM=RS256
ANALYSIS_IDENTITY__JWT_AUDIENCE=kraivor
ANALYSIS_IDENTITY__JWT_ISSUER=kraivor-identity
ANALYSIS_IDENTITY__JWT_VERIFY_EXPIRATION=true
ANALYSIS_IDENTITY__JWT_JWKS_CACHE_TTL=3600
ANALYSIS_IDENTITY__INTERNAL_REQUEST_HEADER=X-Internal-Request

# ── Git ───────────────────────────────────────────────────────────────────
ANALYSIS_GIT__CLONE_TIMEOUT=300
ANALYSIS_GIT__CLONE_DEPTH=1
ANALYSIS_GIT__TEMP_BASE_DIR=/tmp/analysis

# ── Logging ───────────────────────────────────────────────────────────────
ANALYSIS_LOGGING__LEVEL=INFO
ANALYSIS_LOGGING__JSON_FORMAT=false

# ── OpenTelemetry ─────────────────────────────────────────────────────────
ANALYSIS_OTEL__ENABLED=false
ANALYSIS_OTEL__SERVICE_NAME=analysis-service
ANALYSIS_OTEL__ENDPOINT=http://localhost:4318/v1/traces

# ── Sentry ────────────────────────────────────────────────────────────────
ANALYSIS_SENTRY__DSN=
ANALYSIS_SENTRY__ENVIRONMENT=development
ANALYSIS_SENTRY__TRACES_SAMPLE_RATE=0.1
