[flake8]
max-line-length = 88
max-complexity = 10
docstring-convention = google
import-order-style = google
application-import-names = apps, core
extend-ignore =
    # Handled by black:
    E203,
    W503,
    # docstrings - intentionally lax for tests:
    D100,
    D104,
    D107,
    D205,
    D400,
    D401,
    D415,
per-file-ignores =
    __init__.py: F401, D104
    conftest.py: D100, D101, D102, D103
    tests/*: D100, D101, D102, D103, D104, D107, S101
    manage.py: D100, D101, D102, D103
    */migrations/*: D100, D101, D102, D103, D104, D107, D205, D400, D401, D415
exclude =
    .venv,
    .ruff_cache,
    .git,
    __pycache__,
    migrations,
    htmlcov,
    *.egg-info,
