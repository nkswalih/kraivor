# =============================================================================
# Dockerfile.dev — AI Service (Development)
# =============================================================================
# Goals:
#   - Fast container startup
#   - Hot reload via uvicorn --reload
#   - Source code mounted as volume (edit on host — reflected instantly)
#   - venv isolated outside /app (volume mount can't shadow or delete it)
#   - All dependencies including dev (ruff, pytest, etc.)
#   - Dependency layer cached separately from project source
#
# Caching strategy:
#   Layer 1 (deps only): --mount=type=cache reuses downloaded wheels across
#       retries (critical for large wheels like torch). Cache mount is scoped
#       to this RUN only — parent hash + instruction text still governs layer
#       invalidation (on pyproject.toml or uv.lock change).
#   Layer 2 (project):   COPY . ./ invalidates on any source change, then
#       uv sync re-installs the project. --mount=type=cache speeds up
#       re-downloads when this layer is invalidated.
#
# ── Slow-build diagnosis ─────────────────────────────────────────────────────
# If this Dockerfile builds slowly (>5 min) when previously fast:
#
# 1. Restart Docker Desktop / reset WSL2 VM
#    Docker Desktop → Troubleshoot → Reset to factory defaults (keeps images)
#    or: wsl --shutdown  (then relaunch Docker Desktop)
#
# 2. Check Docker Desktop → Settings → Resources
#    Ensure CPU >= 4, Memory >= 4 GB, Disk >= 20 GB allocated to WSL2
#
# 3. Windows Defender exclusion (common #1 cause of slow unpack)
#    Add exclusion for: \\wsl$\docker-desktop-data\  (the WSL2 vhdx)
#    Add exclusion for: C:\Users\<you>\AppData\Local\Docker\wsl\
#    Add exclusion for: the project directory (C:\VS Code\kraivor)
#    Windows Security → Virus & threat protection → Manage settings →
#    Exclusions → Add folder
#
# 4. Verify network health before blaming Dockerfile
#    docker pull hello-world  (should complete in <5s)
#    docker pull python:3.11-slim  (should complete in <30s)
#
# 5. Confirm BuildKit cache wasn't cleared
#    docker builder ls  (check status = running)
#    Do NOT run: docker builder prune  (unless intentional)
#    Check: Docker Desktop → Images → check if layers show "CACHED"
# =============================================================================

FROM python:3.11-slim

WORKDIR /app

# ── System dependencies ──────────────────────────────────────────────────────
RUN for i in 1 2 3; do \
      apt-get update && break || \
      { echo "apt-get update failed (attempt $i/3), retrying in 5s..."; sleep 5; }; \
    done && \
    apt-get install -y --no-install-recommends \
      gcc \
      git \
      curl \
    && rm -rf /var/lib/apt/lists/*

# ── Install uv ──────────────────────────────────────────────────────────────
COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /usr/local/bin/uv

# ── Environment ─────────────────────────────────────────────────────────────
ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    UV_COMPILE_BYTECODE=1 \
    UV_HTTP_TIMEOUT=120 \
    UV_HTTP_RETRIES=5 \
    PATH="/opt/venv/bin:$PATH"

# ── Layer 1: Dependencies only (cached unless pyproject.toml or uv.lock change)
# Cache mount reuses partial downloads on retry. On dependency change, uv
# downloads from the index — the mount avoids re-downloading on transient failures.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    for i in 1 2 3; do \
      uv sync --frozen --no-install-project && exit 0 || \
      echo "uv sync failed (attempt $i/3), retrying in 10s..."; \
      sleep 10; \
    done; \
    exit 1

# ── Layer 2: Application source ─────────────────────────────────────────────
# This layer invalidates on any source file change, but dependencies above
# are already installed and only the project itself needs syncing.
COPY . ./

# ── Layer 3: Install project only (deps already present in /opt/venv) ────────
RUN --mount=type=cache,target=/root/.cache/uv \
    for i in 1 2 3; do \
      uv sync --frozen && exit 0 || \
      echo "uv sync failed (attempt $i/3), retrying in 10s..."; \
      sleep 10; \
    done; \
    exit 1

EXPOSE 8004

# Running as root intentionally for dev — volume mounts and hot reload

# Healthcheck — docker-compose.dev.yml overrides this, but useful standalone
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8004/v1/health || exit 1

# CMD left to docker-compose override (alembic migrate + uvicorn)
CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8004", "--reload"]
